<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes UTF-8 the process ANSI code page (Windows 10 1903 and later), so
     the data folder passed by play.ps1 and the settings, score and profile
     paths derived from it use one encoding. Older Windows ignores this. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="InTheHunt.Native" version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
