{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "In the Hunt",
  "repo": "meathax/inthehunt",
  "inputs": [
    {
      "id": "rom",
      "label": "Your In the Hunt World ROM archive (inthunt.zip or inthunt.7z)",
      "role": "game",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "zip",
            "7z"
          ]
        }
      ]
    }
  ],
  "prepare": {
    "program": [
      "InTheHunt.exe"
    ],
    "args": [
      "--import-rom",
      "{input:rom}"
    ],
    "label": "Checking World ROM chips and importing game data",
    "timeout": 300
  },
  "start": {
    "program": [
      "InTheHunt.exe"
    ],
    "args": [
      "{install}/.local/world"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/.local/world/native-settings.ini"
        }
      ],
      "ensure": {
        "version": "1"
      },
      "new": {
        "version": "1"
      }
    }
  ],
  "saves": [
    "{install}/.local/world/native-settings.ini"
  ],
  "looks": {
    "allowed": false,
    "reason": "Use the built-in CRT presets and enhancements in the game settings.",
    "lines": 240
  },
  "settings": [
    {
      "id": "fullscreen",
      "label": "Display",
      "group": "Video",
      "choices": [
        {
          "label": "Window",
          "set": {
            "fullscreen": "0"
          }
        },
        {
          "label": "Fullscreen",
          "set": {
            "fullscreen": "1"
          }
        }
      ],
      "defaults": {
        "fullscreen": "0"
      }
