<?xml version="1.0"?>
<mamelayout version="2">
  <element name="hull"><image file="hull.svg"/></element>
  <element name="ocean"><image file="ocean.svg"/></element>
  <view name="Black">
    <bounds x="0" y="0" width="320" height="240"/>
    <screen index="0"><bounds x="0" y="0" width="320" height="240"/></screen>
  </view>
  <view name="PressureHull">
    <bounds x="0" y="0" width="320" height="240"/>
    <element ref="hull"><bounds x="-160" y="0" width="160" height="240"/></element>
    <element ref="hull"><bounds x="320" y="0" width="160" height="240"/><orientation flipx="yes"/></element>
    <screen index="0"><bounds x="0" y="0" width="320" height="240"/></screen>
  </view>
  <view name="DeepWater">
    <bounds x="0" y="0" width="320" height="240"/>
    <element ref="ocean"><bounds x="-160" y="0" width="160" height="240"/></element>
    <element ref="ocean"><bounds x="320" y="0" width="160" height="240"/><orientation flipx="yes"/></element>
    <screen index="0"><bounds x="0" y="0" width="320" height="240"/></screen>
  </view>
</mamelayout>
